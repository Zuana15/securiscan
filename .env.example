# MongoDB connection string (not required for the first scan dashboard slice)
MONGODB_URI=mongodb://localhost:27017/securiscan

# URL and secret used when authentication is added
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional: override the project virtual environment used by the scanner route.
# SECURISCAN_PYTHON=C:\\Python312\\python.exe
