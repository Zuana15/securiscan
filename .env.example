# MongoDB connection string for persisted scan history and analytics.
MONGODB_URI=mongodb://localhost:27017/securiscan

# Optional: use public DNS only when your network blocks Atlas mongodb+srv lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Required for credential sign-in sessions. Generate a long random value and never commit it.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Local development only: permits the dashboard's Create account form.
# Keep false in every deployed environment; provision production accounts through an administrator flow.
SECURISCAN_ALLOW_REGISTRATION=false

# Optional: override the project virtual environment used by the scanner route.
# SECURISCAN_PYTHON=C:\\Python312\\python.exe

# Local demonstrations only. Never enable this in a deployed environment.
SECURISCAN_ALLOW_PRIVATE_TARGETS=false
